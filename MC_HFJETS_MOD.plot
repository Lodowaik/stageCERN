# ============================================================
# MC_HFJETS_MOD.plot
# Plot configuration for Rivet analysis MC_HFJETS_MOD
# ============================================================


# ============================================================
# LEPTONS
# ============================================================

# BEGIN PLOT /MC_HFJETS_MOD/pT_electron
Title=Transverse momentum of electrons
XLabel=$p_T^e$ [GeV]
YLabel=$1/\sigma\,d\sigma/dp_T$ [GeV$^{-1}$]
# END PLOT


# BEGIN PLOT /MC_HFJETS_MOD/pT_muon
Title=Transverse momentum of muons
XLabel=$p_T^\mu$ [GeV]
YLabel=$1/\sigma\,d\sigma/dp_T$ [GeV$^{-1}$]
# END PLOT


# BEGIN PLOT /MC_HFJETS_MOD/pT_lepton
Title=Transverse momentum of selected leptons
XLabel=$p_T^\ell$ [GeV]
YLabel=$1/\sigma\,d\sigma/dp_T$ [GeV$^{-1}$]
# END PLOT


# ============================================================
# CHARM-JET OBSERVABLES
# ============================================================

# BEGIN PLOT /MC_HFJETS_MOD/ptCJetLead
Title=Leading c-jet transverse momentum
XLabel=$p_T^{c\text{-jet}}$ [GeV]
YLabel=$1/\sigma\,d\sigma/dp_T$ [GeV$^{-1}$]
# END PLOT


# BEGIN PLOT /MC_HFJETS_MOD/ptCHadrLead
Title=Leading C-hadron transverse momentum
XLabel=$p_T^{c\text{-hadron}}$ [GeV]
YLabel=$1/\sigma\,d\sigma/dp_T$ [GeV$^{-1}$]
# END PLOT


# BEGIN PLOT /MC_HFJETS_MOD/ptfracC
Title=C-hadron transverse-momentum fraction
XLabel=$p_T^{c\text{-hadron}}/p_T^{c\text{-jet}}$
YLabel=$1/\sigma\,d\sigma/dx$
# END PLOT


# BEGIN PLOT /MC_HFJETS_MOD/efracC
Title=C-hadron energy fraction
XLabel=$E^{c\text{-hadron}}/E^{c\text{-jet}}$
YLabel=$1/\sigma\,d\sigma/dx$
# END PLOT


# ============================================================
# B-JET OBSERVABLES
# ============================================================

# BEGIN PLOT /MC_HFJETS_MOD/ptBJetLead
Title=Leading b-jet transverse momentum
XLabel=$p_T^{b\text{-jet}}$ [GeV]
YLabel=$1/\sigma\,d\sigma/dp_T$ [GeV$^{-1}$]
# END PLOT


# BEGIN PLOT /MC_HFJETS_MOD/ptBHadrLead
Title=Leading B-hadron transverse momentum
XLabel=$p_T^{b\text{-hadron}}$ [GeV]
YLabel=$1/\sigma\,d\sigma/dp_T$ [GeV$^{-1}$]
# END PLOT


# BEGIN PLOT /MC_HFJETS_MOD/ptfracB
Title=B-hadron transverse-momentum fraction
XLabel=$p_T^{b\text{-hadron}}/p_T^{b\text{-jet}}$
YLabel=$1/\sigma\,d\sigma/dx$
# END PLOT


# BEGIN PLOT /MC_HFJETS_MOD/efracB
Title=B-hadron energy fraction
XLabel=$E^{b\text{-hadron}}/E^{b\text{-jet}}$
YLabel=$1/\sigma\,d\sigma/dx$
# END PLOT


